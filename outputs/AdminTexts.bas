'=========================================================================
' Teaching Plan - Admin Tool : Arabic texts (Unicode hex, 4 digits per char)
' Import this module together with PlanAdmin. Do not edit by hand.
'=========================================================================
Option Explicit

Public Function T(ByVal k As String) As String
    Dim s As String
    If Len(s) = 0 Then s = TX1(k)
    If Len(s) = 0 Then s = TX2(k)
    If Len(s) = 0 Then s = TX3(k)
    If Len(s) = 0 Then s = TX4(k)
    If Len(s) = 0 Then s = TX5(k)
    If Len(s) = 0 Then s = TX6(k)
    T = s
End Function

Private Function AR(ByVal h As String) As String
    Dim i As Long, s As String
    For i = 1 To Len(h) Step 4
        s = s & ChrW(CLng("&H" & Mid$(h, i, 4)))
    Next i
    AR = s
End Function

